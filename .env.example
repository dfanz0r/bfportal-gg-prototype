# Copy to .env.local for local development.

# The new site's database (compose.yml in this repository).
DATABASE_URL=postgres://bfportal:bfportal@localhost:5433/bfportal

# The old site's database, read by the one-off import only. This is the dev
# database started by docker-compose.yml in the bfportal.gg repository.
LEGACY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
# The public address, for canonical links and previews. Only needed when it
# differs from BETTER_AUTH_URL.
SITE_URL=
BETTER_AUTH_SECRET=

# Discord OAuth application. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
