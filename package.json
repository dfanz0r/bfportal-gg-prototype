{
  "name": "bfportal-gg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx seed/run.ts",
    "db:reference": "tsx seed/reference-run.ts",
    "auth:generate": "pnpm dlx auth@latest generate --config src/server/auth/index.ts --output src/server/db/auth-schema.ts --yes && biome format --write src/server/db/auth-schema.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-router": "1.170.39",
    "@tanstack/solid-router-devtools": "1.167.2",
    "@tanstack/solid-start": "1.168.58",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.0",
    "nitro": "3.0.260610-beta",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.18.0",
    "solid-js": "^1.9.17",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
