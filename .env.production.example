# Copy to .env on the server, beside compose.prod.yml.

# Postgres. It ends up in a connection URL, so keep it to letters and digits:
# openssl rand -hex 24
POSTGRES_PASSWORD=

# The public address of the site, with https and no slash on the end. Forms
# refuse posts from any other origin, so it must be the address testers use.
BETTER_AUTH_URL=https://test.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Discord OAuth application. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloudflare Zero Trust > Networks > Tunnels: the token of the tunnel's
# Docker connector.
TUNNEL_TOKEN=
